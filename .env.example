# Base de Datos - CONFIGURAR EN RAILWAY DASHBOARD
# Para Railway: Obtén la URL de la BD desde el dashboard
# Formato: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/medical_db
MYSQL_URI=postgresql://user:password@localhost:5432/medical_db

# JWT Secret - GENERAR CLAVE SEGURA
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# NUNCA usar en producción la clave por defecto
JWT_SECRET_KEY=generate-a-strong-secret-key-with-64-characters-minimum

# CORS Origins - Lista de orígenes permitidos (separados por coma)
# Ejemplo: https://miapp.vercel.app,https://www.miapp.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Umbral de Diabetes (si es aplicable)
DIABETES_THRESHOLD=0.5

# Entorno - CONFIGURAR EN RAILWAY COMO 'production'
FLASK_ENV=production
DEBUG=False
